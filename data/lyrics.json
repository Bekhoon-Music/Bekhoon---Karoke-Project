{
  "song": "BK001",
  "title": "امشب بخون",
  "artist": "BEKHOON ORIGINAL",
  "duration": 47,
  "lyrics": [
    {
      "start": 4,
      "end": 8,
      "text": "امشب چراغا روشنه"
    },
    {
      "start": 8,
      "end": 12,
      "text": "دل من از غصه دوره"
    },
    {
      "start": 12,
      "end": 16,
      "text": "بذار صداتو بشنوم"
    },
    {
      "start": 16,
      "end": 21,
      "text": "این شب برای ماست، دوباره"
    },
    {
      "start": 21,
      "end": 25,
      "text": "دستاتو بالا ببر"
    },
    {
      "start": 25,
      "end": 29,
      "text": "با ریتم این آهنگ بخون"
    },
    {
      "start": 29,
      "end": 33,
      "text": "هرچی که توی قلبته"
    },
    {
      "start": 33,
      "end": 38,
      "text": "امشب فقط برای من بخون"
    },
    {
      "start": 38,
      "end": 41,
      "text": "🎤 امشب بخون"
    },
    {
      "start": 41,
      "end": 44,
      "text": "بلندتر از همیشه"
    },
    {
      "start": 44,
      "end": 47,
      "text": "اینجا صدای تو، قشنگ‌ترین صدا میشه"
    }
  ]
}